# Only the manager URL and slot IDs/secrets are needed from the host.
# Platform, transport and HTTP port are detected automatically where available.
MANAGER_URL=https://your-manager.onrender.com

# One process runs two independent bot slots when WORKER_ID_2 is present.
WORKER_ID_1=worker-host1-1
WORKER_SECRET_1=replace-with-a-unique-random-secret-at-least-32-characters
WORKER_ID_2=worker-host1-2
WORKER_SECRET_2=replace-with-a-different-random-secret-at-least-32-characters

# Minecraft credentials, proxy, AFK mode and run controls are managed in Discord
# and saved by the manager in Supabase. Do not put Discord/Supabase keys here.

# (Optional) Wispbyte 14-day Auto-KeepAlive
# Automatically pings your Wispbyte Client Panel every 24h to prevent container expiration
# WISPBYTE_COOKIE="session=...; remember_web_...=..."
# WISPBYTE_PANEL_URL=https://wispbyte.com/client

